
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seatechmedia",
  "main": "./worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
